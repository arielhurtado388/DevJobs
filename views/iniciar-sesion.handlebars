<main class="contenedor">
  <form action="/iniciar-sesion" method="POST" class="default-form" novalidate>
    <div class="campo">
      <label>Correo</label>
      <input type="email" name="email" placeholder="Tu correo" />
    </div>
    <div class="campo">
      <label>Contraseña</label>
      <input type="password" name="password" placeholder="Tu contraseña" />
    </div>

    <div class="campo acciones">
      <a href="/crear-cuenta">Crea una cuenta</a>
      <a href="/olvide">Olvidé mi contraseña</a>
    </div>

    <div class="campo">
      <input class="btn btn-azul" type="submit" value="Iniciar sesión" />
    </div>
  </form>
</main>