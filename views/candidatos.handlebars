<main class="lista-candidatos">
  <h2>Lista de candidatos</h2>
  {{#if candidatos.length}}

    {{#each candidatos}}

      <div class="candidato">
        <div class="caja">
          <p class="etiqueta">Nombre</p>
          <p class="nombre">{{nombre}}</p>
        </div>

        <div class="caja">
          <p class="etiqueta">Correo</p>
          <p class="nombre">{{email}}</p>
        </div>

        <div class="caja">
          <a class="btn btn-verde" href="/uploads/cv/{{cv}}">Ver CV</a>
        </div>
      </div>

    {{/each}}

  {{else}}
    <p>No hay candidatos aún</p>

  {{/if}}

</main>