<main class="contenedor">
  <form action="/editar-perfil" method="POST" class="default-form" novalidate>
    <div class="campo">
      <label>Nombre</label>
      <input
        type="text"
        name="nombre"
        placeholder="Tu nombre"
        value="{{usuario.nombre}}"
      />
    </div>

    <div class="campo">
      <label>Correo</label>
      <input
        type="email"
        name="email"
        placeholder="Tu correo"
        value="{{usuario.email}}"
      />
    </div>

    <div class="campo">
      <label>Contraseña</label>
      <input type="password" name="password" placeholder="Tu contraseña" />
    </div>

    <div class="campo">
      <input type="submit" class="btn btn-azul" value="Guardar cambios" />
    </div>
  </form>
</main>