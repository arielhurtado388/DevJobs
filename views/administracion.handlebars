<main class="lista-vacantes">
  <h2>Navegación</h2>
  <div class="botones separador">
    <a class="btn btn-azul" href="/editar-perfil">Editar perfil</a>
    <a class="btn btn-verde" href="/vacantes/nueva">Nueva vacante</a>
  </div>

  <h2>Tus vacantes</h2>
  {{#if vacantes.length}}
    {{#each vacantes}}
      <div class="vacante panel-administracion">
        <div class="caja">
          <h3>{{empresa}}</h3>
          <p class="puesto">{{titulo}}</p>
        </div>
        <div class="centrar-vertical caja">
          <a href="/candidatos/{{id}}" class="btn btn-amarillo">Candidatos</a>
        </div>

        <div class="centrar-vertical caja">
          <a href="/vacantes/editar/{{url}}" class="btn btn-verde">Editar</a>
        </div>

        <div class="centrar-vertical caja">
          <a href="#" data-eliminar="{{id}}" class="btn btn-rojo">Eliminar</a>
        </div>

      </div>
    {{/each}}
  {{else}}
    <p>No hay vacantes, crea una</p>
  {{/if}}
</main>