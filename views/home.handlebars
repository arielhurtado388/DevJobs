<main class="lista-vacantes">
  <h2>Lista de vacantes</h2>

  {{#if vacantes.length}}

    {{#each vacantes}}
      <div class="vacante">
        <div class="caja">
          <h3>{{empresa}}</h3>
          <p class="puesto">{{titulo}}</p>
        </div>
        <div class="caja">
          <p class="etiqueta">Ubicación</p>
          <p class="nombre">{{ubicacion}}</p>
        </div>
        <div class="caja">
          <p class="etiqueta">Contrato</p>
          <p class="nombre contacto">{{contrato}}</p>
        </div>
        <div class="caja centrar-vertical">
          <a class="btn btn-verde" href="/vacantes/{{url}}">Más info</a>
        </div>
      </div>
    {{/each}}
  {{else}}
    <p>No hay vacantes</p>
  {{/if}}
</main>